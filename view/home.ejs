<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Our Service</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-950 text-white font-sans">

    <nav class="fixed top-0 left-0 w-full z-50 bg-gray-950/80 backdrop-blur-md border-b border-gray-800">

        <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">

            <h1 class="text-2xl font-bold">
                <span class="text-indigo-500">Our</span>Service
            </h1>

            <div class="hidden md:flex gap-8 text-gray-300">

                <a href="#home" class="hover:text-indigo-400 transition">
                    Home
                </a>

                <a href="#features" class="hover:text-indigo-400 transition">
                    Features
                </a>

                <a href="#about" class="hover:text-indigo-400 transition">
                    About
                </a>

            </div>

            <a href="#contact" class="bg-indigo-600 hover:bg-indigo-700 px-5 py-2 rounded-lg transition">
                Get Started
            </a>

        </div>

    </nav>

    <section id="home"
        class="min-h-screen flex items-center pt-24 bg-gradient-to-br from-gray-950 via-gray-900 to-indigo-950">

        <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">

            <div>

                <p class="text-indigo-400 font-semibold mb-4">
                    ✨ SIMPLE • FAST • RELIABLE
                </p>

                <h2 class="text-5xl md:text-6xl font-bold leading-tight">
                    Welcome to

                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">
                        Our Service
                    </span>

                </h2>

                <p class="mt-6 text-gray-400 text-lg leading-relaxed max-w-xl">
                    Your solution to better productivity.
                    Work smarter, save time and grow your business
                    with our simple and powerful solutions.
                </p>

                <div class="mt-8 flex gap-4">
                    
                    <a href="#contact"
                        class="bg-indigo-600 hover:bg-indigo-700 px-7 py-3 rounded-xl font-semibold transition">
                        Get Started →
                    </a>

                    <a href="#features"
                        class="border border-gray-700 hover:border-indigo-500 px-7 py-3 rounded-xl font-semibold transition">
                        Learn More
                    </a>

                </div>

            </div>

            <div class="relative">

                <div class="absolute -top-10 -right-10 w-40 h-40 bg-indigo-600/20 rounded-full blur-3xl">
                </div>

                <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-cyan-600/20 rounded-full blur-3xl">
                </div>


                <div class="relative bg-white/5 backdrop-blur-lg border border-white/10 rounded-3xl p-8 shadow-2xl">

                    <div class="flex gap-2 mb-8">

                        <span class="w-3 h-3 bg-red-400 rounded-full"></span>

                        <span class="w-3 h-3 bg-yellow-400 rounded-full"></span>

                        <span class="w-3 h-3 bg-green-400 rounded-full"></span>

                    </div>


                    <div class="space-y-5">

                        <div class="h-4 w-3/4 bg-gray-700 rounded-full"></div>

                        <div class="h-4 w-1/2 bg-indigo-500/50 rounded-full"></div>

                        <div class="grid grid-cols-2 gap-4">

                            <div class="h-28 bg-indigo-500/10
                                border border-indigo-500/20 rounded-2xl">
                            </div>

                            <div class="h-28 bg-cyan-500/10
                                border border-cyan-500/20 rounded-2xl">
                            </div>

                        </div>


                        <div class="h-24 bg-white/5
                            border border-white/10 rounded-2xl">
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <section id="features" class="py-24 bg-gray-900">

        <div class="max-w-6xl mx-auto px-6">

            <div class="text-center max-w-2xl mx-auto">

                <p class="text-indigo-400 font-semibold uppercase tracking-widest text-sm">
                    Our Features
                </p>

                <h2 class="text-4xl md:text-5xl font-bold mt-3">
                    Why Choose Us?
                </h2>

                <p class="mt-5 text-gray-400 text-lg">
                    Everything you need to make your work
                    easier, faster and more productive.
                </p>

            </div>

            <div class="grid md:grid-cols-3 gap-8 mt-14">

                <div
                    class="bg-gray-800/60 border border-gray-700 rounded-3xl p-8 hover:-translate-y-2 hover:border-indigo-500 transition duration-300">

                    <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 flex items-center justify-center text-2xl mb-6">
                        ⚡
                    </div>

                    <h3 class="text-2xl font-semibold mb-4">
                        Fast & Reliable
                    </h3>

                    <p class="text-gray-400 leading-relaxed">
                        Get fast and reliable solutions
                        designed to improve your productivity.
                    </p>

                </div>

                <div
                    class="bg-gray-800/60 border border-gray-700 rounded-3xl p-8 hover:-translate-y-2 hover:border-cyan-500 transition duration-300">
                    <div class="w-14 h-14 rounded-2xl bg-cyan-500/10 flex items-center justify-center text-2xl mb-6">
                        💬
                    </div>

                    <h3 class="text-2xl font-semibold mb-4">
                        Customer Support
                    </h3>

                    <p class="text-gray-400 leading-relaxed">
                        Our dedicated support team is
                        always ready to help you.
                    </p>

                </div>

                <div
                    class="bg-gray-800/60 border border-gray-700 rounded-3xl p-8 hover:-translate-y-2 hover:border-purple-500 transition duration-300">
                    <div class="w-14 h-14 rounded-2xl bg-purple-500/10 flex items-center justify-center text-2xl mb-6">
                        🔗
                    </div>

                    <h3 class="text-2xl font-semibold mb-4">
                        Easy Integration
                    </h3>

                    <p class="text-gray-400 leading-relaxed">

                        Easily connect our tools with
                        your existing systems.

                    </p>

                </div>

            </div>

        </div>

    </section>

    <section id="contact" class="py-24 px-6 bg-gradient-to-r from-indigo-600 to-cyan-600">

        <div class="max-w-4xl mx-auto text-center">

            <p class="uppercase tracking-widest text-white/80 font-semibold text-sm">
                Ready to Start?
            </p>

            <h2 class="text-4xl md:text-5xl font-bold mt-4">
                Take Your Business
                <br>
                to the Next Level
            </h2>

            <p class="mt-6 text-lg text-white/80">
                Join us today and start experiencing
                better productivity and better results.
            </p>

            <button
                class="mt-8 bg-white text-indigo-600 px-8 py-4 rounded-xl font-bold hover:scale-105 transition duration-300">
                Get Started
            </button>
        </div>
    </section>

    <section id="about" class="py-24 bg-gray-900">
        <div class="max-w-6xl mx-auto px-6">
            <div class="grid md:grid-cols-2 gap-14 items-center">
                <div>
                    <p class="text-indigo-400 font-semibold uppercase tracking-widest text-sm">
                        About Us
                    </p>

                    <h2 class="text-4xl md:text-5xl font-bold mt-3 leading-tight">
                        We Make
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">
                            Work Simpler
                        </span>
                    </h2>

                    <p class="mt-6 text-gray-400 text-lg leading-relaxed">
                        Our goal is simple — to provide smart, reliable and
                        easy-to-use solutions that help you save time and
                        focus on what really matters.
                    </p>

                    <p class="mt-4 text-gray-400 leading-relaxed">
                        We combine simple design, powerful technology and
                        excellent support to create a better experience for
                        every customer.
                    </p>

                    <a href="#contact"
                        class="inline-block mt-8 bg-indigo-600 hover:bg-indigo-700 px-7 py-3 rounded-xl font-semibold transition">
                        Learn More →
                    </a>

                </div>

                <div class="grid grid-cols-2 gap-5">

                    <div class="bg-gray-800/70 border border-gray-700 rounded-3xl p-7 text-center">

                        <h3 class="text-4xl font-bold text-indigo-400">
                            100%
                        </h3>

                        <p class="mt-2 text-gray-400">
                            Reliable
                        </p>

                    </div>

                    <div class="bg-gray-800/70 border border-gray-700 rounded-3xl p-7 text-center">
                        <h3 class="text-4xl font-bold text-cyan-400">
                            24/7
                        </h3>

                        <p class="mt-2 text-gray-400">
                            Support
                        </p>
                    </div>

                    <div
                        class="col-span-2 bg-gradient-to-r from-indigo-600/20 to-cyan-600/20 border border-indigo-500/20 rounded-3xl p-8">

                        <h3 class="text-2xl font-semibold">
                            Why We Do It
                        </h3>

                        <p class="mt-3 text-gray-400 leading-relaxed">
                            Because great technology should not be complicated.
                            We believe in creating solutions that are simple,
                            useful and made for real-world needs.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="border-t border-gray-800 bg-gray-950">

        <div class="max-w-6xl mx-auto px-6 py-8 text-center">

            <p class="text-gray-500">

                © 2026 Our Service. All Rights Reserved.

            </p>

        </div>

    </footer>

</body>

</html>